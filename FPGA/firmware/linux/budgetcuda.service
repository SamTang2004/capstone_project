[Unit]
Description=BudgetCUDA protocol service
Requires=budgetcuda-fpga.service
After=network.target budgetcuda-fpga.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/budgetcuda
Environment=XILINX_XRT=/usr
ExecStart=/opt/budgetcuda/budgetcuda-server 9000 64
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
