[Unit]
Description=BudgetCUDA protocol service
Requires=budgetcuda-fpga.service
After=network-online.target budgetcuda-fpga.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/budgetcuda
Environment=XILINX_XRT=/usr
ExecStart=/opt/budgetcuda/budgetcuda-server 9000 16
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
